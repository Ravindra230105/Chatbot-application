NODE_ENV=development
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ollive_inference
DB_USER=root
DB_PASSWORD=


REDIS_HOST=127.0.0.1
REDIS_PORT=6379

INGESTION_URL=http://127.0.0.1:5000
INGESTION_API_KEY=
INGESTION_TIMEOUT_MS=5000

DEFAULT_PROVIDER=groq
DEFAULT_MODEL=llama-3.3-70b-versatile
CONTEXT_MESSAGE_LIMIT=10
MAX_OUTPUT_TOKENS=1024
GEMINI_MAX_OUTPUT_TOKENS=3072
GEMINI_THINKING_LEVEL=low
REDACT_PII=true

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,openai/gpt-oss-20b

OPENAI_MODELS=gpt-4.1-mini,gpt-4o-mini
ANTHROPIC_MODELS=claude-sonnet-4-5,claude-haiku-4-5
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash
